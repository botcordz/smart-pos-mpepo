{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "invoice_id": {
            "type": "string",
            "format": "uuid"
        },
        "invoice_date": {
            "type": "string",
            "format": "date-time"
        },
        "merchant": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "tin": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "name",
                "tin"
            ]
        },
        "customer": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "tin": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "name"
            ]
        },
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "description": {
                        "type": "string"
                    },
                    "quantity": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "unit_price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "tax_rate": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                    }
                },
                "required": [
                    "description",
                    "quantity",
                    "unit_price",
                    "tax_rate"
                ]
            },
            "minItems": 1
        },
        "subtotal": {
            "type": "number",
            "minimum": 0
        },
        "tax_total": {
            "type": "number",
            "minimum": 0
        },
        "discount": {
            "type": "number",
            "minimum": 0
        },
        "total": {
            "type": "number",
            "minimum": 0
        },
        "currency": {
            "type": "string",
            "enum": [
                "ZMW"
            ]
        },
        "payment_method": {
            "type": "string",
            "enum": [
                "cash",
                "mobile_money",
                "bank_transfer",
                "card"
            ]
        },
        "idempotency_key": {
            "type": "string"
        }
    },
    "required": [
        "invoice_id",
        "invoice_date",
        "merchant",
        "items",
        "subtotal",
        "tax_total",
        "total",
        "currency"
    ]
}
